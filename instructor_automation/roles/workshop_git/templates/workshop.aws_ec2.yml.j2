# Generated by workshop_git. Contains AWS credentials; keep this file private.
plugin: amazon.aws.aws_ec2
regions:
  - {{ workshop_git_aws_account.region | to_json }}
access_key: {{ workshop_git_aws_account.access_key | to_json }}
secret_key: {{ workshop_git_aws_account.secret_key | to_json }}
{% if workshop_git_aws_account.session_token | default('') | length > 0 %}
session_token: {{ workshop_git_aws_account.session_token | to_json }}
{% endif %}
filters:
  tag:Name: {{ __workshop_git_plan.resource_name | to_json }}
  tag:WorkshopDeployment: {{ workshop_git_deployment_id | to_json }}
  tag:WorkshopEnvironment: {{ workshop_git_aws_account.name | to_json }}
  tag:ManagedBy: {{ __workshop_git_managed_by | to_json }}
  instance-state-name: running
hostnames:
  - instance-id
strict: true
cache: false
groups:
  workshop_git_servers: "true"
compose:
  ansible_host: public_ip_address
  ansible_user: "'ec2-user'"
  ansible_connection: "'ssh'"
  ansible_python_interpreter: "'/usr/bin/python3'"
  ansible_ssh_private_key_file: {{ workshop_git_ssh_private_key_file | to_json | to_json }}
  ansible_ssh_common_args: {{ ('-o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -o UserKnownHostsFile=' ~ (workshop_git_private_dir ~ '/known_hosts') | quote) | to_json | to_json }}
  workshop_git_controller: {{ inventory_hostname | to_json | to_json }}
  workshop_git_server: >-
    {'environment': ec2_tags.WorkshopEnvironment,
     'fqdn': ec2_tags.WorkshopGitFQDN,
     'url': 'https://' ~ ec2_tags.WorkshopGitFQDN,
     'region': {{ workshop_git_aws_account.region | to_json }},
     'account_id': {{ __workshop_git_plan.account_id | to_json }},
     'instance_id': instance_id,
     'ip_address': public_ip_address}
