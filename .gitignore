# Ignore macOS system files
.DS_Store

# Ignore node_modules directory
node_modules/

# Ignore build output
www/
.cache/

# Ignore IDE and editor files
.vscode/
!.vscode/
.idea/

# Keep Lab 1 Cursor workspace settings that default Dev Containers to Podman
!workshop-content/01-cursor-workspace/.vscode/
!workshop-content/01-cursor-workspace/.vscode/settings.json

# Ignore logs and temporary files
*.log
*.tmp

# Ignore environment-specific files
.env
.env.local
.env.*.local

# Ignore sensitive or private information
secrets.json

# Ignore compiled binaries or executables
*.exe
*.dll
*.so
*.dylib
*.core

# Ignore package-lock.json for npm
package-lock.json

# Ignore yarn.lock for Yarn
yarn.lock

.lock

.ansible

# Learner-generated playbooks (Module 2 / 3)
workshop-content/02-shell-to-ansible/output/**
!workshop-content/02-shell-to-ansible/output/.gitkeep
