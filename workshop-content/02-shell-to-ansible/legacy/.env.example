# Copy to .env. The installer reads it directly; do not source it.
# Real environment variables override this file. Quote values with spaces or #.
NETBOX_VERSION=latest
NETBOX_HOSTNAME=localhost
# * permits access by any IP/hostname on a fresh machine. Narrow this for deployment.
NETBOX_ALLOWED_HOSTS=*
NETBOX_ADMIN_USER=admin
NETBOX_ADMIN_EMAIL=admin@localhost
# Blank values generate unique secrets, saved root-only on the target machine.
# Passwords must be >=12 characters; secret key and pepper must be >=50.
NETBOX_ADMIN_PASSWORD=
NETBOX_DB_PASSWORD=
NETBOX_SECRET_KEY=
NETBOX_API_TOKEN_PEPPER=
NETBOX_TIME_ZONE=UTC
NETBOX_GUNICORN_WORKERS=3
NETBOX_OPEN_FIREWALL=true
# off | self-signed | provided (the latter requires existing PEM files below)
NETBOX_TLS_MODE=off
NETBOX_TLS_CERT=
NETBOX_TLS_KEY=

